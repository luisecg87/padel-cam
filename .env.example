# Copiar a .env (no se commitea) con los datos del proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).
# Sin estas dos variables, el juego se lanza SIN tope de acceso.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Solo para mostrar el numero correcto en el mensaje de "cupo lleno" si por
# algun motivo la respuesta de Supabase no trae el cap (fallback local).
VITE_FREE_CAP=50
